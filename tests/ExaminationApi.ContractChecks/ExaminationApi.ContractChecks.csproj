<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="../../COSGeniusSystem/DTOs/Examinations/*.cs" Link="DTOs/%(Filename)%(Extension)" />
    <Compile Include="../../COSGeniusSystem/DTOs/Treatments/*.cs" Link="DTOs/Treatments/%(Filename)%(Extension)" />
    <Compile Include="../../COSGeniusSystem/DTOs/Reception/*.cs" Link="DTOs/Reception/%(Filename)%(Extension)" />
    <Compile Include="../../COSGeniusSystem/DTOs/Invoices/*.cs" Link="DTOs/Invoices/%(Filename)%(Extension)" />
    <Compile Include="../../COSGeniusSystem/DTOs/Patients/Responses/PatientResponse.cs" Link="PatientResponse.cs" />
    <Compile Include="../../COSGeniusSystem/Commons/*.cs" Link="Commons/%(Filename)%(Extension)" />
    <Compile Include="../../COSGeniusSystem/Exceptions/*.cs" Link="Exceptions/%(Filename)%(Extension)" />
    <Compile Include="../../COSGeniusSystem/Controllers/BaseApiController.cs" Link="BaseApiController.cs" />
    <Compile Include="../../COSGeniusSystem/Controllers/ExaminationsController.cs" Link="ExaminationsController.cs" />
    <Compile Include="../../COSGeniusSystem/Services/Examinations/IExaminationService.cs" Link="IExaminationService.cs" />
    <Compile Include="../../COSGeniusSystem/Controllers/TreatmentsController.cs" Link="TreatmentsController.cs" />
    <Compile Include="../../COSGeniusSystem/Services/Treatments/ITreatmentProtocolService.cs" Link="ITreatmentProtocolService.cs" />
  </ItemGroup>
</Project>
